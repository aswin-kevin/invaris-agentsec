{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invaris.dev/agentsec/policy.schema.json",
  "title": "AgentSec policy (agentsec.yaml)",
  "type": "object",
  "required": [
    "agent"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [
        "1",
        1
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "name",
        "endpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string"
        },
        "api_key_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0.1
        },
        "declare_tools": {
          "type": "boolean"
        },
        "stream": {
          "type": "boolean"
        },
        "retrieval_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_per_1k": {
              "type": "number",
              "minimum": 0
            },
            "output_per_1k": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tool_effects": {
      "type": "object",
      "description": "Tool name -> list of effect tags that tool's call actually produces (read, write, delete, execute, network, external_communication, financial, credential_access, git_mutation, deployment, persistence, delegation, browser_state_change, system_change, the irreversible qualifier, or any project-specific tag). See docs/policy-reference.md#tool_effects.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent_roles": {
      "type": "object",
      "description": "Multi-agent systems: agent name -> the authority that agent holds. effects is the ceiling of what the agent may do itself (tool_effects vocabulary), tools optionally restricts it to named tools, can_delegate_to lists the agents it may hand work to (delegating requires 'delegation' in effects). See docs/multi-agent.md.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "can_delegate_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_repeated_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "spend_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "amount_field": {
          "type": "string",
          "minLength": 1
        },
        "max_transaction": {
          "type": "number",
          "minimum": 0
        },
        "max_total": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "address_allowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "addresses"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "address_field": {
          "type": "string",
          "minLength": 1
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "case_sensitive": {
          "type": "boolean"
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attack_packs": {
      "type": "array",
      "description": "Local plugin modules (file paths or importable module names) exposing extra scenario categories. See docs/extending.md#write-an-attack-pack.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "judge": {
      "type": "object",
      "required": [
        "endpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string"
        },
        "api_key_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0.1
        },
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "goal_hijack",
              "paraphrased_leak"
            ]
          }
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
